diff --git a/backend/app/models/expense.rb b/backend/app/models/expense.rb
index a161c45..45c1c06 100644
--- a/backend/app/models/expense.rb
+++ b/backend/app/models/expense.rb
@@ -1,3 +1,14 @@
 class Expense < ApplicationRecord
   belongs_to :category
+
+  validates :description, :amount, :date, presence: true
+  validate :date_cannot_be_in_the_future # Check professional logic here!
+
+  private
+
+  def date_cannot_be_in_the_future
+    if date.present? && date > Date.current
+      errors.add(:date, "cannot be in the future. You can't spend money tomorrow today!")
+    end
+  end
 end
